  <location path="PM SURYA GHAR KIT CATALOGUE.pdf">
    <system.webServer>
      <httpRedirect enabled="true" destination="https://vrmstructures.in/pm-surya-ghar-kit-catalogue.pdf" exactDestination="true" httpResponseStatus="Permanent" />
