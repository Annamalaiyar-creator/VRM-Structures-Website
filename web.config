      <httpRedirect enabled="true" destination="https://vrmstructures.in/datasheet-waaree-elite-n-type-bifacial-555W-560W-565W-570W-575W-580W-585W.pdf" exactDestination="true" httpResponseStatus="Permanent" />
    </system.webServer>
  </location>
  <!-- Datasheets published by other manufacturers (modules, inverters): keep them downloadable
       but out of search results, where they only duplicate the manufacturer's own copy.
       VRM's own brochure and PM Surya Ghar catalogue stay indexable. -->
  <location path="polycab-solar--inverter-datasheet-india.pdf">
